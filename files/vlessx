#!/bin/bash

CONFIG="/etc/xray/config.json"
DB_FILE="/etc/vless/.vless.db"
LIMIT_DIR="/etc/kyt/limit/vless/ip"
ACCESS_LOG="/var/log/xray/access.log"
LOCK_FILE="/var/lib/kyt/lockipvless.txt"
UNLOCK_FILE="/var/lib/kyt/unlock_vless.txt"
CFG_LOCK="/var/lock/xray_config.lock"
XRAY_BIN=$(command -v xray 2>/dev/null || echo "/usr/local/bin/xray")

mkdir -p "$LIMIT_DIR" /var/lib/kyt /etc/vless /var/lock
touch "$LOCK_FILE" "$UNLOCK_FILE"
chmod 600 "$LOCK_FILE" "$UNLOCK_FILE"

send_telegram() {
    local TEXT="$1"
    local CHATID KEY TIMEOUT URL

    CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 3)
    KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 2)
    [ -z "$CHATID" ] || [ -z "$KEY" ] && return 0

    TIMEOUT="10"
    URL="https://api.telegram.org/bot${KEY}/sendMessage"

    curl -s --max-time "$TIMEOUT" \
        -d "chat_id=${CHATID}" \
        -d "disable_web_page_preview=1" \
        -d "parse_mode=HTML" \
        --data-urlencode "text=${TEXT}" \
        "$URL" >/dev/null 2>&1
}

get_server_tag() {
    local DOMAIN_PART FLAG
    if [ -r "/etc/xray/domain" ]; then
        DOMAIN_PART=$(cut -d '.' -f1 /etc/xray/domain | tr '[:lower:]' '[:upper:]')
    else
        DOMAIN_PART="VPS"
    fi
    if [[ "$DOMAIN_PART" == *"SG"* ]]; then
        FLAG="🇸🇬"
    else
        FLAG="🇮🇩"
    fi
    echo "${DOMAIN_PART} ${FLAG}"
}

send_lock_log() {
    local AKUN="$1"
    local LOGIN_CNT="$2"
    local LIMIT_CNT="$3"
    local IP_LIST="$4"
    local FOOTER_MSG="$5"
    local SERVER_TAG

    SERVER_TAG=$(get_server_tag)
    send_telegram "──────────────────────
🚫 Notifikasi Multilogin VLESS
──────────────────────
<blockquote><code>SERVER ${SERVER_TAG}</code></blockquote>
<code>User  :</code> <code>${AKUN}</code>
<code>Login :</code> <code>${LOGIN_CNT} IP</code>
<code>Limit :</code> <code>${LIMIT_CNT} IP</code>
──────────────────────
${IP_LIST}
──────────────────────
${FOOTER_MSG}
──────────────────────"
}

send_unlock_log() {
    local AKUN="$1"
    local SERVER_TAG

    SERVER_TAG=$(get_server_tag)
    send_telegram "──────────────────────
🔓 Auto-Unlock Akun VLESS
──────────────────────
<blockquote><code>SERVER ${SERVER_TAG}</code></blockquote>
<code>User   :</code> <code>${AKUN}</code>
<code>Status :</code> <code>Aktif Kembali</code>
──────────────────────"
}

safe_restart_xray() {
    if [ -x "$XRAY_BIN" ]; then
        if ! "$XRAY_BIN" run -test -config "$CONFIG" >/dev/null 2>&1; then
            echo "ERROR: config.json tidak valid setelah edit! Memulihkan backup."
            if [ -f "${CONFIG}.vlip.bak" ]; then
                mv "${CONFIG}.vlip.bak" "$CONFIG"
            fi
            return 1
        fi
    fi
    rm -f "${CONFIG}.vlip.bak"
    systemctl restart xray >/dev/null 2>&1
    return 0
}

is_account_locked() {
    local akun="$1"
    awk -v u="$akun" '
        { gsub(/\r/, "") }
        $1 == "#&" && $2 == u {
            getline;
            if ($0 ~ /LOCKED/) { found = 1; exit }
        }
        END { exit(found ? 0 : 1) }
    ' "$CONFIG" 2>/dev/null
}

lock_vless_account() {
    local akun="$1"
    local exp all_uuids uuid rand_str uuid3 rc=0

    LAST_LOCKED_EXP=""
    LAST_LOCKED_UUID=""

    exec 9>"$CFG_LOCK"
    flock -w 15 9 || { exec 9>&-; return 1; }

    exp=$(awk -v u="$akun" '{gsub(/\r/, "")} $1 == "#&" && $2 == u {print $3; exit}' "$CONFIG")
    all_uuids=$(awk -v u="$akun" -v e="$exp" '
        { gsub(/\r/, "") }
        $1 == "#&" && $2 == u && $3 == e {
            getline;
            gsub(/\r/, "");
            if (match($0, /"id"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                s = substr($0, RSTART, RLENGTH);
                sub(/.*:[[:space:]]*"/, "", s);
                sub(/"$/, "", s);
                print s;
            }
        }
    ' "$CONFIG")

    if [ -z "$exp" ] || [ -z "$all_uuids" ]; then
        echo "Exp atau UUID untuk $akun tidak ditemukan, melewati lock."
        rc=1
    elif printf '%s\n' "$all_uuids" | grep -q "LOCKED"; then
        echo "Account $akun sudah terkunci, melewati proses."
        rc=2
    else
        uuid=$(printf '%s\n' "$all_uuids" | head -n 1)
        rand_str=$(head -c 32 /dev/urandom | md5sum | cut -c1-15)
        uuid3="xrayvless${rand_str}LOCKED"

        cp "$CONFIG" "${CONFIG}.vlip.bak"

        if [ -f "$DB_FILE" ]; then
            awk -v u="$akun" '!($1 == "###" && $2 == u)' "$DB_FILE" > "${DB_FILE}.tmp"
            mv "${DB_FILE}.tmp" "$DB_FILE"
        fi
        echo "### ${akun} ${exp} ${uuid}" >> "$DB_FILE"

        sed -i "/^#& ${akun} ${exp}[[:space:]]*$/,/^},{/d" "$CONFIG"
        sed -i '/#vless[[:space:]]*$/a\#& '"${akun} ${exp}"'\
},{"id": "'"${uuid3}"'","email" : "'"${akun}"'"' "$CONFIG"
        sed -i '/#vlessgrpc[[:space:]]*$/a\#& '"${akun} ${exp}"'\
},{"id": "'"${uuid3}"'","email" : "'"${akun}"'"' "$CONFIG"

        LAST_LOCKED_EXP="$exp"
        LAST_LOCKED_UUID="$uuid"
    fi

    flock -u 9
    exec 9>&-
    return "$rc"
}

unlock_vless_account() {
    local akun="$1"
    local saved_exp="$2"
    local saved_uuid="$3"
    local exp_cfg db_uuid final_uuid rc=0

    exec 9>"$CFG_LOCK"
    flock -w 15 9 || { exec 9>&-; return 1; }

    if ! is_account_locked "$akun"; then
        flock -u 9
        exec 9>&-
        return 2
    fi

    exp_cfg=$(awk -v u="$akun" '{gsub(/\r/, "")} $1 == "#&" && $2 == u {print $3; exit}' "$CONFIG")
    exp_cfg="${exp_cfg:-$saved_exp}"

    db_uuid=$(awk -v u="$akun" '$1 == "###" && $2 == u {val=$4} END {print val}' "$DB_FILE" 2>/dev/null)
    final_uuid="${saved_uuid:-$db_uuid}"
    final_uuid="${final_uuid//LOCKED/}"

    if [ -z "$exp_cfg" ] || [ -z "$final_uuid" ]; then
        echo "Gagal auto-unlock $akun: exp atau UUID asli kosong."
        rc=1
    else
        cp "$CONFIG" "${CONFIG}.vlip.bak"

        if [ -f "$DB_FILE" ]; then
            awk -v u="$akun" '!($1 == "###" && $2 == u)' "$DB_FILE" > "${DB_FILE}.tmp"
            mv "${DB_FILE}.tmp" "$DB_FILE"
        fi
        echo "### ${akun} ${exp_cfg} ${final_uuid}" >> "$DB_FILE"

        sed -i "/^#& ${akun} ${exp_cfg}[[:space:]]*$/,/^},{/d" "$CONFIG"
        sed -i '/#vless[[:space:]]*$/a\#& '"${akun} ${exp_cfg}"'\
},{"id": "'"${final_uuid}"'","email" : "'"${akun}"'"' "$CONFIG"
        sed -i '/#vlessgrpc[[:space:]]*$/a\#& '"${akun} ${exp_cfg}"'\
},{"id": "'"${final_uuid}"'","email" : "'"${akun}"'"' "$CONFIG"
    fi

    flock -u 9
    exec 9>&-
    return "$rc"
}

process_auto_unlock() {
    [ ! -s "$UNLOCK_FILE" ] && return 0

    local now tmp_file u unlock_ts s_exp s_uuid unlocked_any unlocked_users rc
    now=$(date +%s)
    tmp_file="${UNLOCK_FILE}.tmp"
    unlocked_any=0
    unlocked_users=()
    : > "$tmp_file"

    while IFS='|' read -r u unlock_ts s_exp s_uuid; do
        [ -z "$u" ] && continue
        if [[ "$unlock_ts" =~ ^[0-9]+$ ]] && (( now >= unlock_ts )); then
            unlock_vless_account "$u" "$s_exp" "$s_uuid"
            rc=$?
            if [ "$rc" -eq 0 ]; then
                echo "Auto-unlock VLESS berhasil untuk $u."
                unlocked_any=1
                unlocked_users+=("$u")
            elif [ "$rc" -eq 2 ]; then
                echo "Akun $u sudah aktif (dibuka manual), jadwal auto-unlock dihapus."
            else
                echo "${u}|${unlock_ts}|${s_exp}|${s_uuid}" >> "$tmp_file"
            fi
        else
            echo "${u}|${unlock_ts}|${s_exp}|${s_uuid}" >> "$tmp_file"
        fi
    done < "$UNLOCK_FILE"

    mv "$tmp_file" "$UNLOCK_FILE"
    chmod 600 "$UNLOCK_FILE"

    if [ "$unlocked_any" -eq 1 ]; then
        if safe_restart_xray; then
            for u in "${unlocked_users[@]}"; do
                send_unlock_log "$u"
            done
        fi
    fi
}

schedule_unlock() {
    local target="$1"
    local duration_sec="$2"
    local orig_exp="$3"
    local orig_uuid="$4"
    local unlock_ts=$(( $(date +%s) + duration_sec ))

    awk -F'|' -v u="$target" '$1 != u' "$UNLOCK_FILE" > "${UNLOCK_FILE}.tmp"
    echo "${target}|${unlock_ts}|${orig_exp}|${orig_uuid}" >> "${UNLOCK_FILE}.tmp"
    mv "${UNLOCK_FILE}.tmp" "$UNLOCK_FILE"
    chmod 600 "$UNLOCK_FILE"
}

clear_lock_count() {
    local target="$1"
    grep -Fxv "$target" "$LOCK_FILE" > "${LOCK_FILE}.tmp" 2>/dev/null || true
    mv "${LOCK_FILE}.tmp" "$LOCK_FILE"
    chmod 600 "$LOCK_FILE"
}

scan_recent_ips() {
    local window_sec="$1"
    local cutoff
    cutoff=$(date -d "${window_sec} seconds ago" +"%Y/%m/%d %H:%M:%S")

    [ ! -r "$ACCESS_LOG" ] && return 0

    tail -n 3000 "$ACCESS_LOG" 2>/dev/null | awk -v cutoff="$cutoff" '
        /accepted/ && /email:/ {
            ts = $1 " " $2;
            gsub(/-/, "/", ts);
            sub(/\..*/, "", ts);
            if (ts < cutoff) next;

            email = "";
            for (i = 1; i <= NF; i++) {
                if ($i == "email:" && i < NF) {
                    email = $(i+1);
                    break;
                }
            }
            if (email == "") next;

            full_ip = "";
            pref = "";
            for (i = 1; i <= NF; i++) {
                if ($i == "from" && i < NF) {
                    raw = $(i+1);
                    sub(/^(tcp|udp):/, "", raw);
                    if (raw ~ /^\[/) {
                        sub(/^\[/, "", raw);
                        sub(/\].*/, "", raw);
                        full_ip = raw;
                        pref = raw;
                    } else {
                        sub(/:.*/, "", raw);
                        full_ip = raw;
                        n = split(raw, oct, ".");
                        if (n == 4) pref = oct[1] "." oct[2];
                        else pref = raw;
                    }
                    break;
                }
            }
            if (pref == "") next;

            key = email SUBSEP pref;
            if (!(key in seen)) {
                seen[key] = 1;
                count[email]++;
                if (ips[email] == "") ips[email] = full_ip;
                else ips[email] = ips[email] "," full_ip;
            }
        }
        END {
            for (u in count) {
                print u "|" count[u] "|" ips[u];
            }
        }
    '
}

format_ip_list() {
    printf '%s\n' "$1" | tr ',' '\n' | awk 'NF {print NR ". " $0}'
}

while true; do
    # 1. Buka akun yang masa lock-nya sudah berakhir
    process_auto_unlock

    echo "Memulai proses monitoring Limit IP VLESS."
    mapfile -t data < <(awk '{gsub(/\r/, "")} /^#& / {print $2}' "$CONFIG" 2>/dev/null | sort -u)

    # 2. Tahap 1: Scan IP aktif 60 detik terakhir
    unset pass1_count user_limits
    declare -A pass1_count
    declare -A user_limits
    suspects=()

    while IFS='|' read -r u cnt _; do
        [ -z "$u" ] && continue
        pass1_count["$u"]="$cnt"
    done < <(scan_recent_ips 60)

    for akun in "${data[@]}"; do
        jum1="${pass1_count[$akun]:-0}"
        [ "$jum1" -eq 0 ] && continue

        iplimit=$(tr -d '[:space:]' < "${LIMIT_DIR}/${akun}" 2>/dev/null)
        if ! [[ "$iplimit" =~ ^[0-9]+$ ]] || (( iplimit <= 0 )); then
            iplimit=2
            echo "$iplimit" > "${LIMIT_DIR}/${akun}"
        fi

        echo "Memproses User : [Login: $jum1 IP, Limit: $iplimit IP] $akun"
        if (( jum1 > iplimit )); then
            suspects+=("$akun")
            user_limits["$akun"]="$iplimit"
        fi
    done

    # 3. Tahap 2: Validasi ulang 45 detik jika ada indikasi multilogin
    NEED_RESTART=0
    if [ "${#suspects[@]}" -gt 0 ]; then
        echo "Terdeteksi ${#suspects[@]} indikasi multilogin VLESS, validasi ulang 45 detik..."
        for _ in 1 2 3; do
            sleep 15
            process_auto_unlock
        done

        unset pass2_count pass2_ips
        declare -A pass2_count
        declare -A pass2_ips

        while IFS='|' read -r u cnt ip_csv; do
            [ -z "$u" ] && continue
            pass2_count["$u"]="$cnt"
            pass2_ips["$u"]="$ip_csv"
        done < <(scan_recent_ips 45)

        for akun in "${suspects[@]}"; do
            jum2="${pass2_count[$akun]:-0}"
            iplimit="${user_limits[$akun]}"

            if (( jum2 > iplimit )); then
                if is_account_locked "$akun"; then
                    echo "Akun $akun sudah berstatus LOCKED, melewati."
                    continue
                fi

                echo "Mulog $akun valid, Login [$jum2 IP / Limit $iplimit IP]"
                ip_formatted=$(format_ip_list "${pass2_ips[$akun]}")

                echo "$akun" >> "$LOCK_FILE"
                viol_count=$(grep -Fxc "$akun" "$LOCK_FILE")

                if (( viol_count == 1 )); then
                    if lock_vless_account "$akun"; then
                        echo "Locked user $akun selama 5 menit (1X Multilogin)"
                        schedule_unlock "$akun" 300 "$LAST_LOCKED_EXP" "$LAST_LOCKED_UUID"
                        send_lock_log "$akun" "$jum2" "$iplimit" "$ip_formatted" "Notif 1X Multilogin: Lock 5 Menit"
                        NEED_RESTART=1
                    fi
                elif (( viol_count == 2 )); then
                    if lock_vless_account "$akun"; then
                        echo "Locked user $akun selama 10 menit (2X Multilogin)"
                        schedule_unlock "$akun" 600 "$LAST_LOCKED_EXP" "$LAST_LOCKED_UUID"
                        send_lock_log "$akun" "$jum2" "$iplimit" "$ip_formatted" "Notif 2X Multilogin: Lock 10 Menit"
                        NEED_RESTART=1
                    fi
                elif (( viol_count == 3 )); then
                    if lock_vless_account "$akun"; then
                        echo "Locked user $akun selama 20 menit (3X Multilogin)"
                        schedule_unlock "$akun" 1200 "$LAST_LOCKED_EXP" "$LAST_LOCKED_UUID"
                        send_lock_log "$akun" "$jum2" "$iplimit" "$ip_formatted" "Notif 3X Multilogin: Lock 20 Menit"
                        NEED_RESTART=1
                    fi
                else
                    if lock_vless_account "$akun"; then
                        echo "Locked user $akun PERMANEN (4X Multilogin)"
                        send_lock_log "$akun" "$jum2" "$iplimit" "$ip_formatted" "Notif 4X Multilogin: Locked Permanen!"
                        clear_lock_count "$akun"
                        NEED_RESTART=1
                    fi
                fi
            else
                echo "Mulog $akun tidak valid pada cek ke-2, Login [$jum2 IP]"
            fi
        done
    fi

    if [ "$NEED_RESTART" -eq 1 ]; then
        echo "Terjadi penguncian multilogin, restart layanan xray."
        safe_restart_xray
    fi

    echo "Start vtrip"
    echo "Siklus monitoring selesai. sleep 60 detik!"

    for _ in 1 2 3 4; do
        sleep 15
        process_auto_unlock
    done
done