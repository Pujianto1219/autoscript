#!/bin/bash

CONFIG="/etc/xray/config.json"
DB_FILE="/etc/trojan/.trojan.db"
QUOTA_DIR="/etc/trojan"
USAGE_DIR="/etc/limit/trojan"

mkdir -p "$QUOTA_DIR" "$USAGE_DIR"

send_log() {
    local USER_NAME="$1"
    local USAGE_STR="$2"
    local LIMIT_STR="$3"

    local CHATID KEY DOMAIN_PART FLAG TIMEOUT URL TEXT
    CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 3)
    KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 2)

    [ -z "$CHATID" ] || [ -z "$KEY" ] && return 0

    if [ -r "/etc/xray/domain" ]; then
        DOMAIN_PART=$(cut -d '.' -f1 /etc/xray/domain | tr '[:lower:]' '[:upper:]')
    else
        DOMAIN_PART="VPS"
    fi

    if [[ "$DOMAIN_PART" == *"SG"* ]]; then
        FLAG="🇸🇬"
    else
        FLAG="🇮🇩"
    fi

    TIMEOUT="10"
    URL="https://api.telegram.org/bot${KEY}/sendMessage"
    TEXT="──────────────────────
🚫 Notifikasi Limit Quota TROJAN
──────────────────────
<blockquote><code>SERVER ${DOMAIN_PART} ${FLAG}</code></blockquote>
<code>User  :</code> <code>${USER_NAME}</code>
<code>Usage :</code> <code>${USAGE_STR}</code>
<code>Limit :</code> <code>${LIMIT_STR}</code>
──────────────────────
Limit Quota Tercapai: Chat Admin
──────────────────────"

    curl -s --max-time "$TIMEOUT" \
        -d "chat_id=${CHATID}" \
        -d "disable_web_page_preview=1" \
        -d "parse_mode=HTML" \
        --data-urlencode "text=${TEXT}" \
        "$URL" >/dev/null 2>&1
}

con() {
    local val="$1"
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        echo "0 B"
        return
    fi
    if (( val < 1024 )); then
        echo "${val} B"
    elif (( val < 1048576 )); then
        echo "$(( (val + 1023) / 1024 )) KB"
    elif (( val < 1073741824 )); then
        echo "$(( (val + 1048575) / 1048576 )) MB"
    else
        echo "$(( (val + 1073741823) / 1073741824 )) GB"
    fi
}

while true; do
    echo "Memulai proses monitoring Quota TROJAN."
    sleep 30

    mapfile -t data < <(awk '{gsub(/\r/, "")} /^#! / {print $2}' "$CONFIG" 2>/dev/null | sort -u)

    for user in "${data[@]}"; do
        raw_stat=$(xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" 2>&1)

        if ! printf '%s\n' "$raw_stat" | grep -qi "failed"; then
            downlink=$(printf '%s\n' "$raw_stat" | awk -F':' '/"value"/ {gsub(/[^0-9]/, "", $2); print $2; exit}')
            downlink=${downlink:-0}

            if [[ "$downlink" =~ ^[0-9]+$ ]] && (( downlink > 0 )); then
                prev=$(tr -d '[:space:]' < "${USAGE_DIR}/${user}" 2>/dev/null)
                [[ "$prev" =~ ^[0-9]+$ ]] || prev=0
                total_bytes=$(( prev + downlink ))
                echo "$total_bytes" > "${USAGE_DIR}/${user}"
                xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" -reset >/dev/null 2>&1
            elif [ ! -f "${USAGE_DIR}/${user}" ]; then
                echo "0" > "${USAGE_DIR}/${user}"
            fi
        fi
    done

    NEED_RESTART=0
    for user in "${data[@]}"; do
        checkLimit=$(tr -d '[:space:]' < "${QUOTA_DIR}/${user}" 2>/dev/null)
        if ! [[ "$checkLimit" =~ ^[0-9]+$ ]] || (( checkLimit == 0 )); then
            checkLimit=536870912000
            echo "$checkLimit" > "${QUOTA_DIR}/${user}"
        fi

        Usage=$(tr -d '[:space:]' < "${USAGE_DIR}/${user}" 2>/dev/null)
        [[ "$Usage" =~ ^[0-9]+$ ]] || Usage=0

        total=$(con "$Usage")
        total2=$(con "$checkLimit")
        echo "Memproses User : [Usage: $total, Limit: $total2] $user"

        if (( Usage > checkLimit )); then
            exp=$(awk -v u="$user" '{gsub(/\r/, "")} $1 == "#!" && $2 == u {print $3; exit}' "$CONFIG")
            all_uuids=$(awk -v u="$user" -v e="$exp" '
                { gsub(/\r/, "") }
                $1 == "#!" && $2 == u && $3 == e {
                    getline;
                    gsub(/\r/, "");
                    if (match($0, /"password"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                        s = substr($0, RSTART, RLENGTH);
                        sub(/.*:[[:space:]]*"/, "", s);
                        sub(/"$/, "", s);
                        print s;
                    }
                }
            ' "$CONFIG")

            if [ -z "$exp" ] || [ -z "$all_uuids" ]; then
                echo "User $user memiliki exp atau Password kosong. Melewati."
                continue
            fi

            if printf '%s\n' "$all_uuids" | grep -q "LOCKED"; then
                echo "Account $user sudah terkunci, melewati proses."
                continue
            fi

            uuid=$(printf '%s\n' "$all_uuids" | head -n 1)
            rand_str=$(head -c 32 /dev/urandom | md5sum | cut -c1-15)
            uuid3="xraytrojan${rand_str}LOCKED"

            if [ -f "$DB_FILE" ]; then
                awk -v u="$user" '!($1 == "###" && $2 == u)' "$DB_FILE" > "${DB_FILE}.tmp"
                mv "${DB_FILE}.tmp" "$DB_FILE"
            fi
            echo "### ${user} ${exp} ${uuid}" >> "$DB_FILE"

            sed -i "/^#! ${user} ${exp}[[:space:]]*$/,/^},{/d" "$CONFIG"
            sed -i '/#trojanws[[:space:]]*$/a\#! '"${user} ${exp}"'\
},{"password": "'"${uuid3}"'","email" : "'"${user}"'"' "$CONFIG"
            sed -i '/#trojangrpc[[:space:]]*$/a\#! '"${user} ${exp}"'\
},{"password": "'"${uuid3}"'","email" : "'"${user}"'"' "$CONFIG"

            echo "0" > "${USAGE_DIR}/${user}"
            send_log "$user" "$total" "$total2"
            echo "User $user melebihi batas kuota, akun dikunci & notif terkirim."
            NEED_RESTART=1
        fi
    done

    if [ "$NEED_RESTART" -eq 1 ]; then
        systemctl restart xray >/dev/null 2>&1
    fi

    echo "Siklus monitoring selesai. sleep 60 detik!"
    sleep 60
done
